# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase database configuration
SUPABASE_URL=
# service-role key: server-side only, never in a front end or a public repo
SUPABASE_SERVICE_KEY=

# Optional tracing (LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arm-copilot

# OpenRouter (optional): one key for many models. To use it set ARM_LLM_PROVIDER=openrouter,
# then set both model names below in OpenRouter's "vendor/model" form (copy from openrouter.ai/models).
ARM_LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Model names in OpenRouter's vendor/model format
ARM_ROUTER_MODEL=
ARM_ANSWER_MODEL=
OTEL_SDK_DISABLED=true

# Embedding model for OpenRouter
ARM_EMBEDDING_MODEL=

ARM_MAX_ANSWER_TOKENS=3000
ARM_TOP_K=8